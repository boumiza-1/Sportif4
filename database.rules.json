{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "products": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === 'admin'"
    },
    "categories": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === 'admin'"
    },
    "settings": {
      "store": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === 'admin'"
      }
    },
    "orders": {
      ".indexOn": [
        "userId"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === 'admin' || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === 'admin'",
      "$orderId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('paymentMethod').val() === 'cash_on_delivery' && newData.child('items').exists() && newData.child('name').isString() && newData.child('phone').isString() && newData.child('phone').val().matches(/^[2459][0-9]{7}$/) && newData.child('city').isString() && newData.child('address').isString()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "adminPushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('admins').child(auth.uid).val() === 'admin'",
        "$deviceId": {
          ".write": "auth != null && auth.uid === $uid && root.child('admins').child(auth.uid).val() === 'admin'",
          ".validate": "newData.hasChildren(['token','updatedAt']) && newData.child('token').isString() && newData.child('token').val().length >= 30 && newData.child('token').val().length <= 4096 && newData.child('updatedAt').isNumber()"
        }
      }
    }
  }
}
